# Local dev: a plain file-based SQLite database via libSQL.
# Production: point this at a hosted libSQL/Turso database URL (libsql://...)
# and set DATABASE_AUTH_TOKEN below.
DATABASE_URL="file:./dev.db"

# Only required when DATABASE_URL points at a remote libSQL/Turso database.
# DATABASE_AUTH_TOKEN=""

# Required only for AI-generated conversation-topic suggestions on the
# contact detail page. Get a key at https://console.anthropic.com — without
# it, the app works normally and that one feature shows a clear "unavailable"
# message instead of crashing.
# ANTHROPIC_API_KEY=""
